@{
    ViewData["Title"] = "Registration Successful";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                    </div>

                    <h3 class="card-title mb-3">Registration Successful</h3>
                    <p class="text-muted mb-4">Your account has been created successfully. You can now sign in with your email and password.</p>

                    <a asp-action="Login" asp-controller="Account" class="btn btn-primary">
                        Continue to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>