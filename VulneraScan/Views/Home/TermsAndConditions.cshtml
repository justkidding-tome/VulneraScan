@{
    ViewData["Title"] = "Terms and Conditions";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-4">
                    <h1 class="mb-0">
                        <i class="bi bi-file-text me-3"></i>Terms and Conditions
                    </h1>
                </div>
                <div class="card-body p-5">
                    <div class="terms-content">
                        <!-- Last Updated -->
                        <div class="alert alert-info mb-4" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Last Updated:</strong> January 2025
                        </div>

                        <!-- 1. Purpose of the System -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-1-circle me-2"></i>Purpose of the System
                            </h2>
                            <p>
                                VulneraScan is a comprehensive vulnerability assessment and penetration testing platform designed to help organizations identify, analyze, and remediate security vulnerabilities in their IT infrastructure. The system provides security professionals with tools to conduct vulnerability scans, analyze results, generate detailed reports, and track remediation efforts.
                            </p>
                        </section>

                        <!-- 2. Authorized Use -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-2-circle me-2"></i>Authorized Use
                            </h2>
                            <p>VulneraScan is intended for legitimate security testing and vulnerability assessment purposes only. Authorized users include:</p>
                            <ul class="ms-4">
                                <li>Security professionals and administrators</li>
                                <li>Authorized penetration testers</li>
                                <li>System owners and operators</li>
                                <li>IT compliance officers</li>
                                <li>Any individual with explicit authorization from the system owner</li>
                            </ul>
                            <p class="mt-3">
                                All use of VulneraScan must comply with applicable laws, regulations, and organizational policies. Unauthorized access or use is strictly prohibited.
                            </p>
                        </section>

                        <!-- 3. User Responsibilities -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-3-circle me-2"></i>User Responsibilities
                            </h2>
                            <p>Users of VulneraScan are responsible for:</p>
                            <ul class="ms-4">
                                <li>Maintaining the confidentiality of their login credentials</li>
                                <li>Notifying administrators immediately if credentials are compromised</li>
                                <li>Conducting scans only on systems they own or have explicit authorization to test</li>
                                <li>Using the results and recommendations responsibly and in accordance with applicable laws</li>
                                <li>Protecting scan results and reports that may contain sensitive security information</li>
                                <li>Complying with all applicable laws, regulations, and organizational security policies</li>
                                <li>Reporting security vulnerabilities or system issues to administrators promptly</li>
                            </ul>
                        </section>

                        <!-- 4. Prohibited Activities -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-4-circle me-2"></i>Prohibited Activities
                            </h2>
                            <p>Users shall not:</p>
                            <ul class="ms-4">
                                <li>Conduct unauthorized scans on systems they do not own or have permission to test</li>
                                <li>Use VulneraScan to conduct cyberattacks or malicious activities</li>
                                <li>Attempt to gain unauthorized access to the system or its data</li>
                                <li>Share credentials or provide unauthorized access to other individuals</li>
                                <li>Reverse engineer, decompile, or attempt to discover the system's source code</li>
                                <li>Interfere with system operation or attempt to disrupt service availability</li>
                                <li>Use the system for purposes other than legitimate security assessment</li>
                                <li>Violate intellectual property rights or attempt to remove copyright notices</li>
                                <li>Distribute scan results publicly without proper authorization</li>
                            </ul>
                        </section>

                        <!-- 5. Account Responsibilities -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-5-circle me-2"></i>Account Responsibilities
                            </h2>
                            <p>
                                Users are responsible for all activities that occur under their account. Administrators may suspend or terminate accounts that violate these terms, engage in prohibited activities, or pose a security risk to the system. User accounts are subject to access controls and activity monitoring for security and compliance purposes.
                            </p>
                        </section>

                        <!-- 6. Vulnerability Assessment Disclaimer -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-6-circle me-2"></i>Vulnerability Assessment Disclaimer
                            </h2>
                            <p>
                                VulneraScan provides vulnerability assessment and analysis tools. While we strive for accuracy, VulneraScan does not guarantee that all vulnerabilities will be identified or that identified results are 100% accurate. Assessment results should be verified and validated by qualified security professionals. The system's recommendations are for informational purposes and should be reviewed by qualified personnel before implementation.
                            </p>
                        </section>

                        <!-- 7. Intellectual Property -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-7-circle me-2"></i>Intellectual Property
                            </h2>
                            <p>
                                VulneraScan, including all software, tools, reports, documentation, and content, is the intellectual property of the organization. Users are granted a limited, non-exclusive license to use VulneraScan for authorized purposes only. Users may not copy, modify, distribute, or create derivative works without explicit written permission. All rights not expressly granted are reserved.
                            </p>
                        </section>

                        <!-- 8. Limitation of Liability -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-8-circle me-2"></i>Limitation of Liability
                            </h2>
                            <p>
                                TO THE MAXIMUM EXTENT PERMITTED BY LAW, VULNERASCAN IS PROVIDED "AS IS" WITHOUT WARRANTY OF ANY KIND. THE ORGANIZATION SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES ARISING FROM THE USE OF VULNERASCAN, INCLUDING BUT NOT LIMITED TO LOSS OF DATA, BUSINESS INTERRUPTION, OR SECURITY BREACHES, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
                            </p>
                        </section>

                        <!-- 9. Policy Updates -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-9-circle me-2"></i>Policy Updates
                            </h2>
                            <p>
                                These Terms and Conditions may be updated at any time. Continued use of VulneraScan following modifications constitutes acceptance of the updated terms. Users are responsible for reviewing updates periodically. Significant changes will be communicated to users when possible.
                            </p>
                        </section>

                        <!-- 10. Contact Information -->
                        <section class="mb-4">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-10-circle me-2"></i>Contact Information
                            </h2>
                            <p>For questions or concerns regarding these Terms and Conditions, please contact:</p>
                            <div class="alert alert-light border mt-3 ms-4">
                                <strong>Support Team</strong><br />
                                Email: <a href="mailto:support@vulnerascan.local">support@vulnerascan.local</a><br />
                                Department: Information Security
                            </div>
                        </section>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-5 pt-4 border-top">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-arrow-left me-2"></i>Back to Login
                                </a>
                            </div>
                            <div class="col-md-6 mb-3">
                                <a href="@Url.Action("PrivacyPolicy", "Home")" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-arrow-right me-2"></i>View Privacy Policy
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Print Notice -->
            <div class="alert alert-secondary mt-4" role="alert">
                <i class="bi bi-printer me-2"></i>
                <strong>Tip:</strong> You can print or save this page for your records using your browser's print function.
            </div>
        </div>
    </div>
</div>

<style>
    .terms-content h2 {
        color: #1e40af;
        font-weight: 600;
        margin-top: 1.5rem;
    }

    .terms-content ul {
        line-height: 1.8;
    }

    .terms-content li {
        margin-bottom: 0.5rem;
    }

    .terms-content p {
        line-height: 1.7;
        color: #374151;
    }

    .card-header {
        background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
    }
</style>
