@{
    ViewData["Title"] = "About";
}

<div class="container py-5">
    <h1 class="mb-4"><i class="bi bi-info-circle me-2"></i>About VulneraScan</h1>
    <p class="lead">VulneraScan is a web-based vulnerability assessment portal designed to help security analysts and administrators scan targets, identify vulnerabilities, and generate professional reports with remediation guidance.</p>

    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Key Features</h4>
            <ul>
                <li>Port scanning and service detection</li>
                <li>Automated vulnerability detection and classification</li>
                <li>Role-based dashboards and user management</li>
                <li>PDF report generation with recommendations</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h4>Contact & Support</h4>
            <p>If you need help or want to report an issue, please use the contact page to send us a message.</p>
        </div>
    </div>
</div>
