@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-4">
                    <h1 class="mb-0">
                        <i class="bi bi-shield-lock me-3"></i>Privacy Policy
                    </h1>
                </div>
                <div class="card-body p-5">
                    <div class="privacy-content">
                        <!-- Last Updated -->
                        <div class="alert alert-info mb-4" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Last Updated:</strong> January 2025
                        </div>

                        <!-- 1. Information Collected -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-1-circle me-2"></i>Information Collected
                            </h2>
                            <p>VulneraScan collects the following types of information:</p>
                            <div class="ms-4">
                                <h5 class="fw-600 mt-3">Personal Information</h5>
                                <ul>
                                    <li>Full name and email address</li>
                                    <li>User account credentials and authentication data</li>
                                    <li>IP addresses and login timestamps</li>
                                    <li>Account creation and activity dates</li>
                                </ul>

                                <h5 class="fw-600 mt-3">Scan and Assessment Data</h5>
                                <ul>
                                    <li>Target systems and network information provided for scanning</li>
                                    <li>Vulnerability scan results and findings</li>
                                    <li>Port scanning results and service discovery data</li>
                                    <li>Security recommendations and remediation guidance</li>
                                    <li>Assessment reports and historical data</li>
                                </ul>

                                <h5 class="fw-600 mt-3">System and Audit Data</h5>
                                <ul>
                                    <li>User access logs and session information</li>
                                    <li>System activity and action audit trails</li>
                                    <li>Browser and device information</li>
                                    <li>Timestamps of all actions and transactions</li>
                                </ul>
                            </div>
                        </section>

                        <!-- 2. Purpose of Data Collection -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-2-circle me-2"></i>Purpose of Data Collection
                            </h2>
                            <p>Data collected by VulneraScan is used for:</p>
                            <ul class="ms-4">
                                <li>User authentication and account management</li>
                                <li>Conducting vulnerability assessments and security scans</li>
                                <li>Generating security reports and recommendations</li>
                                <li>Maintaining audit logs for security and compliance purposes</li>
                                <li>Detecting and preventing unauthorized access or abuse</li>
                                <li>Improving system performance and functionality</li>
                                <li>Enforcing security policies and Terms and Conditions</li>
                                <li>Complying with legal and regulatory requirements</li>
                                <li>Resolving technical issues and user support</li>
                            </ul>
                        </section>

                        <!-- 3. User Information Protection -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-3-circle me-2"></i>User Information Protection
                            </h2>
                            <p>
                                VulneraScan implements industry-standard security measures to protect user information. Access to personal data is restricted to authorized personnel only and is governed by strict access control policies. Data is protected against unauthorized access, alteration, and destruction through multiple layers of security controls.
                            </p>
                        </section>

                        <!-- 4. Database Security -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-4-circle me-2"></i>Database Security
                            </h2>
                            <p>VulneraScan employs comprehensive database security measures:</p>
                            <ul class="ms-4">
                                <li>Access control lists and role-based access control (RBAC)</li>
                                <li>Regular security updates and patches</li>
                                <li>Database activity monitoring and audit logging</li>
                                <li>Physical security measures for database servers</li>
                                <li>Regular backups and disaster recovery procedures</li>
                                <li>Network segmentation and firewall protection</li>
                                <li>Intrusion detection and prevention systems</li>
                            </ul>
                        </section>

                        <!-- 5. Encryption of Sensitive Data -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-5-circle me-2"></i>Encryption of Sensitive Data
                            </h2>
                            <p>
                                Sensitive information is encrypted both in transit and at rest. All data transmission between the client and server uses HTTPS with TLS encryption. Passwords are hashed using industry-standard algorithms and salting techniques. Sensitive data fields are encrypted in the database to provide an additional layer of protection against unauthorized access.
                            </p>
                        </section>

                        <!-- 6. Authentication Security -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-6-circle me-2"></i>Authentication Security
                            </h2>
                            <p>VulneraScan implements robust authentication controls:</p>
                            <ul class="ms-4">
                                <li>Strong password requirements (minimum 8 characters with complexity rules)</li>
                                <li>Account lockout after multiple failed login attempts</li>
                                <li>Session timeout after period of inactivity</li>
                                <li>Secure cookie handling and session management</li>
                                <li>Audit logging of all login attempts and access events</li>
                                <li>IP-based tracking and anomaly detection</li>
                                <li>User account deactivation controls</li>
                            </ul>
                        </section>

                        <!-- 7. Scan Data Handling -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-7-circle me-2"></i>Scan Data Handling
                            </h2>
                            <p>
                                Vulnerability scan results and associated data are treated as sensitive information. Scan results are only accessible to authorized users associated with the assessment. Reports are generated securely and stored encrypted in the database. Users are responsible for maintaining the confidentiality of downloaded reports. Scan data is protected from unauthorized access through access control mechanisms and activity auditing.
                            </p>
                        </section>

                        <!-- 8. Data Retention -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-8-circle me-2"></i>Data Retention
                            </h2>
                            <p>
                                VulneraScan retains user and scan data according to organizational policies and legal requirements. Audit logs are retained to maintain a complete audit trail for security and compliance purposes. Users may request data deletion in accordance with applicable data protection regulations. Deleted data is permanently removed from all systems and backups in accordance with established procedures.
                            </p>
                        </section>

                        <!-- 9. User Rights -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-9-circle me-2"></i>User Rights
                            </h2>
                            <p>Users have the following rights regarding their data:</p>
                            <ul class="ms-4">
                                <li>Right to access their personal information</li>
                                <li>Right to request correction of inaccurate data</li>
                                <li>Right to request deletion of data (subject to legal and operational requirements)</li>
                                <li>Right to request data portability where applicable</li>
                                <li>Right to object to certain processing of their data</li>
                                <li>Right to withdraw consent for data processing</li>
                                <li>Right to lodge complaints with data protection authorities</li>
                            </ul>
                            <p class="mt-3">
                                To exercise any of these rights, please contact the Support Team using the information in the Contact Information section.
                            </p>
                        </section>

                        <!-- 10. Session and Cookie Usage -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-10-circle me-2"></i>Session and Cookie Usage
                            </h2>
                            <p>
                                VulneraScan uses secure session cookies to maintain user authentication and session state. Cookies are set to secure and HTTP-only flags to prevent unauthorized access. Session data is stored server-side and cannot be modified by clients. Users can clear cookies in their browser settings, which will result in session termination. The system does not use tracking cookies or third-party analytics.
                            </p>
                        </section>

                        <!-- 11. Policy Updates -->
                        <section class="mb-5">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-11-circle me-2"></i>Policy Updates
                            </h2>
                            <p>
                                This Privacy Policy may be updated periodically to reflect changes in data handling practices or compliance requirements. Users will be notified of significant changes when possible. Continued use of VulneraScan following policy updates constitutes acceptance of the revised policy.
                            </p>
                        </section>

                        <!-- 12. Contact Information -->
                        <section class="mb-4">
                            <h2 class="h4 mb-3">
                                <i class="bi bi-12-circle me-2"></i>Contact Information
                            </h2>
                            <p>For privacy-related questions or to exercise your data rights, please contact:</p>
                            <div class="alert alert-light border mt-3 ms-4">
                                <strong>Privacy Team</strong><br />
                                Email: <a href="mailto:privacy@vulnerascan.local">privacy@vulnerascan.local</a><br />
                                Department: Information Security<br />
                                Response Time: Within 10 business days
                            </div>
                        </section>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-5 pt-4 border-top">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <a href="@Url.Action("TermsAndConditions", "Home")" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-arrow-left me-2"></i>View Terms & Conditions
                                </a>
                            </div>
                            <div class="col-md-6 mb-3">
                                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-arrow-right me-2"></i>Back to Login
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Print Notice -->
            <div class="alert alert-secondary mt-4" role="alert">
                <i class="bi bi-printer me-2"></i>
                <strong>Tip:</strong> You can print or save this page for your records using your browser's print function.
            </div>
        </div>
    </div>
</div>

<style>
    .privacy-content h2 {
        color: #1e40af;
        font-weight: 600;
        margin-top: 1.5rem;
    }

    .privacy-content h5 {
        color: #374151;
        font-weight: 600;
    }

    .privacy-content ul {
        line-height: 1.8;
    }

    .privacy-content li {
        margin-bottom: 0.5rem;
    }

    .privacy-content p {
        line-height: 1.7;
        color: #374151;
    }

    .card-header {
        background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
    }
</style>
