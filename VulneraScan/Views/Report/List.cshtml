@model VulneraScan.ViewModels.Report.ReportListViewModel

@{
    ViewData["Title"] = "Security Reports";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-text me-2"></i>Security Reports</h2>
        <a href="@Url.Action("Index", "Scan")" class="btn btn-primary">
            <i class="bi bi-search me-2"></i>New Scan
        </a>
    </div>

    @if (Model.Reports.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small" id="reports-row-count"></span>
                    <input type="text" id="reports-search" class="form-control form-control-sm w-auto" placeholder="Search reports…" style="min-width:220px;">
                </div>
                <div class="table-responsive">
                    <table class="table mb-0" id="reports-table">
                        <thead>
                            <tr>
                                <th>Report Title</th>
                                <th>Target</th>
                                <th>Risk Level</th>
                                <th>Risk Score</th>
                                <th>Generated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reports-tbody">
                            @foreach (var report in Model.Reports)
                            {
                                <tr>
                                    <td>
                                        <strong>@report.Title</strong>
                                    </td>
                                    <td>
                                        <small>@report.ScanTarget.TargetUrl</small>
                                    </td>
                                    <td>
                                        <span class="badge text-@(report.RiskLabel == VulneraScan.Models.Enums.RiskLabel.High ? "danger" : report.RiskLabel == VulneraScan.Models.Enums.RiskLabel.Medium ? "warning" : "success")">
                                            @report.RiskLabel
                                        </span>
                                    </td>
                                    <td>
                                        <strong>@report.RiskScore</strong>
                                    </td>
                                    <td>
                                        <small>@report.GeneratedAt.ToString("g")</small>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Detail", "Report", new { id = report.Id })" class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye me-1"></i>
                                        </a>
                                        <form method="post" asp-action="DownloadPdf" asp-controller="Report" asp-route-id="@report.Id" style="display: inline;" title="Download PDF">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-secondary">
                                                <i class="bi bi-download me-1"></i>
                                            </button>
                                        </form>
                                        <button type="button" 
                                                class="btn btn-sm btn-warning archive-report-btn" 
                                                title="Archive Report"
                                                data-report-id="@report.Id"
                                                data-report-title="@report.Title">
                                            <i class="bi bi-archive me-1"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="reports-pagination" class="d-flex justify-content-center mt-3"></div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No reports found. <a href="@Url.Action("Index", "Scan")">Start a new scan</a> to generate reports.
        </div>
    }
</div>

@* ── Hidden archive form (submitted by modal) ─────────────────── *@
<form id="archiveReportForm" asp-action="Archive" asp-controller="Report" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="archiveReportId" name="id" value="" />
</form>

@* ── Archive confirmation modal ───────────────────────────────── *@
<div class="modal fade" id="archiveReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-archive me-2 text-warning"></i>Archive Report
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Are you sure you want to archive this report?</p>
                <p class="fw-semibold mb-0" id="archiveReportTitleDisplay"></p>
                <p class="text-muted small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>The report will be moved to your Archive and removed from this list.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="archiveConfirmBtn">
                    <i class="bi bi-archive me-1"></i>Archive
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    function initPagination(tbodyId, paginationId, searchId, countId, pageSize) {
        const tbody      = document.getElementById(tbodyId);
        const pagination = document.getElementById(paginationId);
        const searchEl   = document.getElementById(searchId);
        const countEl    = document.getElementById(countId);
        if (!tbody || !pagination) return;

        let currentPage = 1;

        function filterRows() {
            const q = searchEl ? searchEl.value.toLowerCase().trim() : '';
            Array.from(tbody.rows).forEach(row => {
                row.dataset.matches = (!q || row.textContent.toLowerCase().includes(q)) ? '1' : '0';
            });
        }

        function render() {
            filterRows();
            const rows  = Array.from(tbody.rows).filter(r => r.dataset.matches !== '0');
            const total = rows.length;
            const pages = Math.max(1, Math.ceil(total / pageSize));
            currentPage = Math.min(currentPage, pages);
            const start = (currentPage - 1) * pageSize;
            const end   = start + pageSize;

            Array.from(tbody.rows).forEach(row => {
                row.style.display = (row.dataset.matches !== '0' && rows.indexOf(row) >= start && rows.indexOf(row) < end)
                    ? '' : 'none';
            });

            if (countEl) countEl.textContent = total > 0
                ? `Showing ${Math.min(start + 1, total)}–${Math.min(end, total)} of ${total}`
                : 'No results';

            buildPager(pages);
        }

        function buildPager(pages) {
            pagination.innerHTML = '';
            if (pages <= 1) return;
            const ul = document.createElement('ul');
            ul.className = 'pagination pagination-sm mb-0';
            const mkLi = (label, page, disabled, active) => {
                const li = document.createElement('li');
                li.className = `page-item${disabled ? ' disabled' : ''}${active ? ' active' : ''}`;
                const a = document.createElement('a');
                a.className = 'page-link'; a.href = '#'; a.innerHTML = label;
                if (!disabled) a.addEventListener('click', e => { e.preventDefault(); currentPage = page; render(); });
                li.appendChild(a); ul.appendChild(li);
            };
            mkLi('&laquo;', currentPage - 1, currentPage === 1, false);
            for (let i = 1; i <= pages; i++) mkLi(i, i, false, i === currentPage);
            mkLi('&raquo;', currentPage + 1, currentPage === pages, false);
            pagination.appendChild(ul);
        }

        if (searchEl) searchEl.addEventListener('input', () => { currentPage = 1; render(); });
        render();
    }

    initPagination('reports-tbody', 'reports-pagination', 'reports-search', 'reports-row-count', 10);

    // ── Archive modal logic ──────────────────────────────────────
    const archiveModalEl = document.getElementById('archiveReportModal');
    if (archiveModalEl) {
        const archiveModal   = new bootstrap.Modal(archiveModalEl);
        const archiveTitleEl = document.getElementById('archiveReportTitleDisplay');
        const archiveIdEl    = document.getElementById('archiveReportId');
        const archiveForm    = document.getElementById('archiveReportForm');
        const confirmBtn     = document.getElementById('archiveConfirmBtn');

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.archive-report-btn');
            if (btn) {
                archiveIdEl.value = btn.dataset.reportId;
                archiveTitleEl.textContent = btn.dataset.reportTitle;
                archiveModal.show();
            }
        });

        if (confirmBtn) {
            confirmBtn.addEventListener('click', () => {
                archiveModal.hide();
                archiveForm.submit();
            });
        }
    }
}());
</script>
}
