@model VulneraScan.ViewModels.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .dashboard-stat-card {
        border-radius: 1rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        height: 100%;
        overflow: hidden;
        position: relative;
    }
    .dashboard-stat-icon {
        position: absolute;
        right: -10px;
        bottom: -10px;
        opacity: 0.15;
        font-size: 5rem;
    }
    .dashboard-stat-value {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 0.25rem;
    }
    .dashboard-stat-label {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.85rem;
        opacity: 0.8;
    }
    .dashboard-card {
        border-radius: 1rem;
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .dashboard-card-header {
        background-color: transparent;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 1.25rem 1.5rem;
    }
    .table-modern th {
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #6b7280;
        border-bottom: 2px solid #f3f4f6;
    }
    .table-modern td {
        vertical-align: middle;
        padding: 1rem 0.5rem;
        border-bottom: 1px solid #f3f4f6;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Administrator Dashboard</h2>
            <p class="text-muted mb-0">Overview of system health, users, and security scans.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-people me-2"></i>Users
            </a>
            <a href="@Url.Action("ManageReports", "Admin")" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-file-text me-2"></i>Reports
            </a>
        </div>
    </div>

    <!-- Primary Stats -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card bg-primary-subtle text-primary-emphasis">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label">Total Users</div>
                    <div class="dashboard-stat-value">@Model.TotalUsers</div>
                    <i class="bi bi-people-fill dashboard-stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card bg-info-subtle text-info-emphasis">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label">Total Scans</div>
                    <div class="dashboard-stat-value">@Model.TotalScans</div>
                    <i class="bi bi-search dashboard-stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card bg-dark-subtle text-dark-emphasis">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label">Vulnerabilities</div>
                    <div class="dashboard-stat-value">@Model.TotalVulnerabilities</div>
                    <i class="bi bi-shield-exclamation dashboard-stat-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card bg-secondary-subtle text-secondary-emphasis">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label">Reports Generated</div>
                    <div class="dashboard-stat-value">@Model.TotalReports</div>
                    <i class="bi bi-file-earmark-bar-graph dashboard-stat-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary/Risk Stats -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card" style="background-color: #fef2f2;">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label text-danger">High Risk Findings</div>
                    <div class="dashboard-stat-value text-danger">@Model.HighRiskFindings</div>
                    <i class="bi bi-exclamation-octagon-fill dashboard-stat-icon text-danger"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card" style="background-color: #fffbeb;">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label text-warning" style="color: #ea580c !important;">Medium Risk Findings</div>
                    <div class="dashboard-stat-value" style="color: #ea580c;">@Model.MediumRiskFindings</div>
                    <i class="bi bi-exclamation-triangle-fill dashboard-stat-icon" style="color: #ea580c;"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card" style="background-color: #f0fdf4;">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label text-success">Low Risk Findings</div>
                    <div class="dashboard-stat-value text-success">@Model.LowRiskFindings</div>
                    <i class="bi bi-check-circle-fill dashboard-stat-icon text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card dashboard-stat-card" style="background-color: #f8f9fa;">
                <div class="card-body p-4">
                    <div class="dashboard-stat-label text-muted">Active Users</div>
                    <div class="dashboard-stat-value text-dark">@Model.ActiveUsers<span class="fs-5 text-muted fw-normal">/@Model.TotalUsers</span></div>
                    <i class="bi bi-person-check-fill dashboard-stat-icon text-secondary"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Recent Scans</h5>
                    <a href="@Url.Action("Index", "Scan")" class="btn btn-sm btn-light rounded-pill">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentScans.Any())
                    {
                        <div class="table-responsive px-4">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>Target</th>
                                        <th>User</th>
                                        <th>Date</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var scan in Model.RecentScans.Take(10))
                                    {
                                        <tr>
                                            <td class="fw-medium text-dark">@scan.TargetUrl</td>
                                            <td class="text-muted">@scan.User.FullName</td>
                                            <td class="text-muted">@scan.CreatedAt.ToString("MMM dd, HH:mm")</td>
                                            <td class="text-end">
                                                @{
                                                    var scanStatusCss = scan.ScanStatus.ToString() switch
                                                    {
                                                        "Completed"  => "status-completed",
                                                        "InProgress" => "status-inprogress",
                                                        "Failed"     => "status-failed",
                                                        "Pending"    => "status-pending",
                                                        _            => "status-unknown"
                                                    };
                                                }
                                                <span class="status-text @scanStatusCss">@scan.ScanStatus</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-search fs-1 mb-3 d-block opacity-50"></i>
                            <p class="mb-0">No recent scans found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Recent Reports</h5>
                    <a href="@Url.Action("ManageReports", "Admin")" class="btn btn-sm btn-light rounded-pill">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentReports.Any())
                    {
                        <div class="table-responsive px-4">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>Report</th>
                                        <th>User</th>
                                        <th>Date</th>
                                        <th class="text-end">Risk Level</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in Model.RecentReports.Take(10))
                                    {
                                        <tr>
                                            <td class="fw-medium text-dark text-truncate" style="max-width: 200px;">@report.Title</td>
                                            <td class="text-muted">@report.User.FullName</td>
                                            <td class="text-muted">@report.GeneratedAt.ToString("MMM dd, HH:mm")</td>
                                            <td class="text-end">
                                                @{
                                                    var riskStatusCss = report.RiskLabel.ToString() switch
                                                    {
                                                        "High"   => "status-high",
                                                        "Medium" => "status-medium",
                                                        "Low"    => "status-low",
                                                        _        => "status-unknown"
                                                    };
                                                }
                                                <span class="status-text @riskStatusCss">@report.RiskLabel</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-file-earmark-text fs-1 mb-3 d-block opacity-50"></i>
                            <p class="mb-0">No recent reports found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Footer -->
    <div class="d-flex flex-wrap gap-3 mt-5 pb-3 border-top pt-4">
        <a href="@Url.Action("Statistics", "Admin")" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-graph-up me-2"></i>Detailed Statistics
        </a>
        <a href="@Url.Action("AuditLogs", "Admin")" class="btn btn-outline-danger rounded-pill px-4 ms-auto">
            <i class="bi bi-shield-lock me-2"></i>System Audit Logs
        </a>
    </div>
</div>

<style>
    .status-text {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .status-completed {
        color: #16a34a;
    }

    .status-inprogress {
        color: #d97706;
    }

    .status-failed {
        color: #dc2626;
    }

    .status-pending {
        color: #2563eb;
    }

    .status-high {
        color: #dc2626;
    }

    .status-medium {
        color: #d97706;
    }

    .status-low {
        color: #16a34a;
    }

    .status-unknown {
        color: #6b7280;
    }
</style>

