@model UserListViewModel
@{
    ViewData["Title"] = "Admin Users";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">User Management</h1>
        <p class="text-muted mb-0">Manage administrator and analyst accounts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Statistics" class="btn btn-outline-primary">View Statistics</a>
        <a asp-action="CreateUser" class="btn btn-primary">Create User</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small" id="users-row-count"></span>
            <input type="text" id="users-search" class="form-control form-control-sm w-auto" placeholder="Search users…" style="min-width:220px;">
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="users-table">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Lockout Status</th>
                        <th>Created</th>
                        <th>Scans</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="users-tbody">
                    @if (Model.Users.Any())
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="fw-semibold">@user.FullName</td>
                                <td>@user.Email</td>
                                <td><span class="badge bg-secondary">@user.Role</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="form-check form-switch mb-0" title="@(user.IsActive ? "Active — click to deactivate" : "Inactive — click to activate")">
                                            <input class="form-check-input user-status-toggle"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="toggle-@user.Id"
                                                   data-user-id="@user.Id"
                                                   data-user-name="@user.FullName"
                                                   @(user.IsActive ? "checked" : "")
                                                   style="cursor:pointer; width:2.5em; height:1.35em;">
                                        </div>
                                        <label class="mb-0 user-status-label @(user.IsActive ? "text-success" : "text-secondary") fw-medium"
                                               for="toggle-@user.Id"
                                               style="cursor:pointer; min-width:56px; font-size:0.85rem;">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsLockedOut)
                                    {
                                        <span class="badge bg-danger">Locked Out</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@user.ScanCount</td>
                                <td>
                                   <div class="d-flex justify-content-end gap-2">
                                       <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                           <i class="bi bi-pencil"></i>
                                       </a>
                                       @if (user.IsLockedOut)
                                       {
                                           <form asp-action="UnlockAccount" method="post" class="d-inline">
                                               @Html.AntiForgeryToken()
                                               <input type="hidden" name="id" value="@user.Id" />
                                               <button type="submit" class="btn btn-sm btn-outline-warning" title="Unlock Account" onclick="return confirm('Unlock account for @user.FullName?');">
                                                   <i class="bi bi-unlock"></i>
                                               </button>
                                           </form>
                                       }
                                       <form asp-action="ArchiveUser" method="post" class="d-inline">
                                           @Html.AntiForgeryToken()
                                           <input type="hidden" name="id" value="@user.Id" />
                                           <button type="submit" class="btn btn-sm btn-outline-warning" title="Archive" onclick="return confirm('Are you sure you want to archive this record?');">
                                               <i class="bi bi-archive"></i>
                                           </button>
                                       </form>
                                   </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="users-pagination" class="d-flex justify-content-center mt-3"></div>
    </div>
</div>

@* ── Toggle confirmation modal ────────────────────────────────── *@
<div class="modal fade" id="toggleStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="toggleModalTitle">Confirm Status Change</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="toggleModalBody">
                Are you sure you want to change this user's status?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" id="toggleCancelBtn" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="toggleConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

@* ── Toast notification ───────────────────────────────────────── *@
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100">
    <div id="statusToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="statusToastBody">Status updated.</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ── Pagination helper ────────────────────────────────────────
    function initPagination(tbodyId, paginationId, searchId, countId, pageSize) {
        const tbody      = document.getElementById(tbodyId);
        const pagination = document.getElementById(paginationId);
        const searchEl   = document.getElementById(searchId);
        const countEl    = document.getElementById(countId);
        if (!tbody || !pagination) return;

        let currentPage = 1;

        function allRows() {
            return Array.from(tbody.querySelectorAll('tr[data-visible!="false"]'));
        }

        function filterRows() {
            const q = searchEl ? searchEl.value.toLowerCase().trim() : '';
            Array.from(tbody.rows).forEach(row => {
                const text = row.textContent.toLowerCase();
                row.dataset.matches = (!q || text.includes(q)) ? '1' : '0';
            });
        }

        function render() {
            filterRows();
            const rows     = Array.from(tbody.rows).filter(r => r.dataset.matches !== '0');
            const total    = rows.length;
            const pages    = Math.max(1, Math.ceil(total / pageSize));
            currentPage    = Math.min(currentPage, pages);
            const start    = (currentPage - 1) * pageSize;
            const end      = start + pageSize;

            Array.from(tbody.rows).forEach(row => {
                row.style.display = (row.dataset.matches !== '0' && rows.indexOf(row) >= start && rows.indexOf(row) < end)
                    ? '' : 'none';
            });

            if (countEl) {
                countEl.textContent = total > 0
                    ? `Showing ${Math.min(start + 1, total)}–${Math.min(end, total)} of ${total}`
                    : 'No results';
            }

            buildPager(pages);
        }

        function buildPager(pages) {
            pagination.innerHTML = '';
            if (pages <= 1) return;

            const ul = document.createElement('ul');
            ul.className = 'pagination pagination-sm mb-0';

            const mkLi = (label, page, disabled, active) => {
                const li  = document.createElement('li');
                li.className = `page-item${disabled ? ' disabled' : ''}${active ? ' active' : ''}`;
                const a   = document.createElement('a');
                a.className = 'page-link';
                a.href = '#';
                a.innerHTML = label;
                if (!disabled) a.addEventListener('click', e => { e.preventDefault(); currentPage = page; render(); });
                li.appendChild(a);
                ul.appendChild(li);
            };

            mkLi('&laquo;', currentPage - 1, currentPage === 1, false);
            for (let i = 1; i <= pages; i++) mkLi(i, i, false, i === currentPage);
            mkLi('&raquo;', currentPage + 1, currentPage === pages, false);

            pagination.appendChild(ul);
        }

        if (searchEl) {
            searchEl.addEventListener('input', () => { currentPage = 1; render(); });
        }

        render();
    }

    // Initialise users table
    initPagination('users-tbody', 'users-pagination', 'users-search', 'users-row-count', 10);

    // ── Active/Inactive toggle ───────────────────────────────────
    const modal        = new bootstrap.Modal(document.getElementById('toggleStatusModal'));
    const modalTitle   = document.getElementById('toggleModalTitle');
    const modalBody    = document.getElementById('toggleModalBody');
    const confirmBtn   = document.getElementById('toggleConfirmBtn');
    const cancelBtn    = document.getElementById('toggleCancelBtn');
    const toastEl      = document.getElementById('statusToast');
    const toastBody    = document.getElementById('statusToastBody');
    const bsToast      = new bootstrap.Toast(toastEl, { delay: 3000 });

    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    let pendingToggle = null;  // { checkbox, userId, userName, newState }

    document.querySelectorAll('.user-status-toggle').forEach(checkbox => {
        checkbox.addEventListener('change', function (e) {
            e.preventDefault();
            // Revert the checkbox visually — wait for confirmation
            this.checked = !this.checked;

            const userId   = this.dataset.userId;
            const userName = this.dataset.userName;
            const newState = !this.checked;   // what we WANT to set

            pendingToggle = { checkbox: this, userId, userName, newState };

            const action = newState ? 'activate' : 'deactivate';
            modalTitle.textContent = newState ? 'Activate Account' : 'Deactivate Account';
            modalBody.innerHTML    = `Are you sure you want to <strong>${action}</strong> the account for <strong>${userName}</strong>?`;
            confirmBtn.className   = `btn ${newState ? 'btn-success' : 'btn-danger'}`;
            confirmBtn.textContent = newState ? 'Activate' : 'Deactivate';

            modal.show();
        });
    });

    cancelBtn.addEventListener('click', () => { pendingToggle = null; });

    confirmBtn.addEventListener('click', async () => {
        if (!pendingToggle) return;
        const { checkbox, userId, userName } = pendingToggle;
        modal.hide();

        try {
            const resp = await fetch('@Url.Action("ToggleUserStatus", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': antiForgeryToken
                },
                body: `id=${encodeURIComponent(userId)}&__RequestVerificationToken=${encodeURIComponent(antiForgeryToken)}`
            });

            const data = await resp.json();

            if (data.success) {
                checkbox.checked = data.isActive;
                const label = document.querySelector(`label[for="toggle-${userId}"]`);
                if (label) {
                    label.textContent = data.isActive ? 'Active' : 'Inactive';
                    label.className   = `mb-0 user-status-label fw-medium ${data.isActive ? 'text-success' : 'text-secondary'}`;
                }
                toastEl.classList.remove('bg-success', 'bg-danger');
                toastEl.classList.add(data.isActive ? 'bg-success' : 'bg-secondary');
                toastBody.textContent = `${userName} has been ${data.isActive ? 'activated' : 'deactivated'}.`;
            } else {
                toastEl.classList.remove('bg-success', 'bg-secondary');
                toastEl.classList.add('bg-danger');
                toastBody.textContent = data.message ?? 'Failed to update status.';
            }

            bsToast.show();
        } catch {
            toastEl.classList.remove('bg-success', 'bg-secondary');
            toastEl.classList.add('bg-danger');
            toastBody.textContent = 'Network error — please try again.';
            bsToast.show();
        }

        pendingToggle = null;
    });
}());
</script>
}