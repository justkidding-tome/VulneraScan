@model ManageReportsViewModel
@{
    ViewData["Title"] = "Manage Reports";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Report Management</h1>
        <p class="text-muted mb-0">Review and manage scan reports for the entire platform.</p>
    </div>
    <a asp-action="Users" class="btn btn-outline-primary">Back to Users</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small" id="reports-row-count"></span>
            <input type="text" id="reports-search" class="form-control form-control-sm w-auto" placeholder="Search reports…" style="min-width:220px;">
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="reports-table">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Owner</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Risk</th>
                        <th>Generated</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="reports-tbody">
                    @if (Model.Reports.Any())
                    {
                        foreach (var report in Model.Reports)
                        {
                            var ownerName = report.User?.FullName ?? report.User?.Email ?? "Unknown";

                            var riskTextClass = report.RiskLabel == RiskLabel.High
                                                        ? "text-danger"
                                                        : report.RiskLabel == RiskLabel.Medium
                                                            ? "text-warning"
                                                            : "text-success";

                            <tr>
                                <td class="fw-semibold">@report.Title</td>
                                <td>@ownerName</td>
                                <td>@report.ScanTarget?.TargetUrl</td>
                                <td>
                                    @await Html.PartialAsync("_StatusText", report.ScanTarget?.ScanStatus.ToString() ?? "Unknown")
                                </td>
                                <td>
                                    <span class="@riskTextClass fw-bold">
                                        @report.RiskLabel (@report.RiskScore)
                                    </span>
                                </td>
                                <td>@report.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Detail" asp-controller="Report" asp-route-id="@report.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning archive-report-btn"
                                                title="Archive"
                                                data-report-id="@report.Id"
                                                data-report-title="@report.Title">
                                            <i class="bi bi-archive me-1"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No reports available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="reports-pagination" class="d-flex justify-content-center mt-3"></div>
    </div>
</div>

@* ── Hidden archive form (submitted by modal) ─────────────────── *@
<form id="archiveReportForm" asp-action="ArchiveReport" asp-controller="Admin" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="archiveReportId" name="id" value="" />
</form>

@* ── Archive confirmation modal ───────────────────────────────── *@
<div class="modal fade" id="archiveReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-archive me-2 text-warning"></i>Archive Report
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Are you sure you want to archive the following report?</p>
                <p class="fw-semibold mb-0" id="archiveReportTitleDisplay"></p>
                <p class="text-muted small mt-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>The report will be moved to the Archive and removed from the active list.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="archiveConfirmBtn">
                    <i class="bi bi-archive me-1"></i>Archive
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    // ── Pagination helper ────────────────────────────────────────
    function initPagination(tbodyId, paginationId, searchId, countId, pageSize) {
        const tbody      = document.getElementById(tbodyId);
        const pagination = document.getElementById(paginationId);
        const searchEl   = document.getElementById(searchId);
        const countEl    = document.getElementById(countId);
        if (!tbody || !pagination) return;

        let currentPage = 1;

        function filterRows() {
            const q = searchEl ? searchEl.value.toLowerCase().trim() : '';
            Array.from(tbody.rows).forEach(row => {
                row.dataset.matches = (!q || row.textContent.toLowerCase().includes(q)) ? '1' : '0';
            });
        }

        function render() {
            filterRows();
            const rows  = Array.from(tbody.rows).filter(r => r.dataset.matches !== '0');
            const total = rows.length;
            const pages = Math.max(1, Math.ceil(total / pageSize));
            currentPage = Math.min(currentPage, pages);
            const start = (currentPage - 1) * pageSize;
            const end   = start + pageSize;

            Array.from(tbody.rows).forEach(row => {
                row.style.display = (row.dataset.matches !== '0' && rows.indexOf(row) >= start && rows.indexOf(row) < end)
                    ? '' : 'none';
            });

            if (countEl) countEl.textContent = total > 0
                ? `Showing ${Math.min(start + 1, total)}–${Math.min(end, total)} of ${total}`
                : 'No results';

            buildPager(pages);
        }

        function buildPager(pages) {
            pagination.innerHTML = '';
            if (pages <= 1) return;
            const ul = document.createElement('ul');
            ul.className = 'pagination pagination-sm mb-0';
            const mkLi = (label, page, disabled, active) => {
                const li = document.createElement('li');
                li.className = `page-item${disabled ? ' disabled' : ''}${active ? ' active' : ''}`;
                const a = document.createElement('a');
                a.className = 'page-link'; a.href = '#'; a.innerHTML = label;
                if (!disabled) a.addEventListener('click', e => { e.preventDefault(); currentPage = page; render(); });
                li.appendChild(a); ul.appendChild(li);
            };
            mkLi('&laquo;', currentPage - 1, currentPage === 1, false);
            for (let i = 1; i <= pages; i++) mkLi(i, i, false, i === currentPage);
            mkLi('&raquo;', currentPage + 1, currentPage === pages, false);
            pagination.appendChild(ul);
        }

        if (searchEl) searchEl.addEventListener('input', () => { currentPage = 1; render(); });
        render();
    }

    initPagination('reports-tbody', 'reports-pagination', 'reports-search', 'reports-row-count', 10);

    // ── Archive modal ────────────────────────────────────────────
    const archiveModal   = new bootstrap.Modal(document.getElementById('archiveReportModal'));
    const archiveTitleEl = document.getElementById('archiveReportTitleDisplay');
    const archiveIdEl    = document.getElementById('archiveReportId');
    const archiveForm    = document.getElementById('archiveReportForm');
    const confirmBtn     = document.getElementById('archiveConfirmBtn');

    document.querySelectorAll('.archive-report-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            archiveIdEl.value        = this.dataset.reportId;
            archiveTitleEl.textContent = this.dataset.reportTitle;
            archiveModal.show();
        });
    });

    confirmBtn.addEventListener('click', () => {
        archiveModal.hide();
        archiveForm.submit();
    });
}());
</script>
}