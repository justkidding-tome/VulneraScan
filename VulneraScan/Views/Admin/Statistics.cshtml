@model AdminStatisticsViewModel
@{
    ViewData["Title"] = "System Statistics";
}

<style>
    .stat-card {
        border-radius: 0.75rem;
        border: none;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    .stat-card .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .stat-card .stat-value {
        font-size: 1.85rem;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }
    .stat-card .stat-label {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
    }
    .section-divider {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #9ca3af;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #f3f4f6;
        margin-bottom: 1rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">System Statistics</h1>
        <p class="text-muted mb-0">Administrative overview of users, scans, reports, and logs.</p>
    </div>
    <a asp-action="Users" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-1"></i>Back to Users
    </a>
</div>


<div class="section-divider"><i class="bi bi-people me-1"></i>Users</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Total Users</div>
                    <div class="stat-value text-dark">@Model.TotalUsers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Active Users</div>
                    <div class="stat-value text-success">@Model.ActiveUsers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-person-dash-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Inactive Users</div>
                    <div class="stat-value text-secondary">@Model.InactiveUsers</div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="section-divider"><i class="bi bi-search me-1"></i>Scans</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-broadcast"></i>
                </div>
                <div>
                    <div class="stat-label">Total Scans</div>
                    <div class="stat-value text-dark">@Model.TotalScans</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Completed Scans</div>
                    <div class="stat-value text-success">@Model.CompletedScans</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="stat-label">Pending Scans</div>
                    <div class="stat-value text-warning">@Model.PendingScans</div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="section-divider"><i class="bi bi-folder2-open me-1"></i>Reports &amp; Data</div>
<div class="row g-3">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                </div>
                <div>
                    <div class="stat-label">Reports</div>
                    <div class="stat-value text-dark">@Model.TotalReports</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-shield-exclamation"></i>
                </div>
                <div>
                    <div class="stat-label">Vulnerabilities</div>
                    <div class="stat-value text-danger">@Model.TotalVulnerabilities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-hdd-network"></i>
                </div>
                <div>
                    <div class="stat-label">Port Results</div>
                    <div class="stat-value text-dark">@Model.TotalPortResults</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div>
                    <div class="stat-label">Services</div>
                    <div class="stat-value text-dark">@Model.TotalServices</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-2">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="stat-icon bg-dark bg-opacity-10 text-dark">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <div class="stat-label">Audit Entries</div>
                    <div class="stat-value text-dark">@Model.AuditLogEntries</div>
                </div>
            </div>
        </div>
    </div>
</div>
